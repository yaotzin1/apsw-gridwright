{
  "name": "@apsw/gridwright-vue",
  "version": "0.1.0",
  "description": "Vue 3 adapter for @apsw/gridwright: renders the framework-neutral view layer with <Gridwright>, useGridwright, and custom cell slots.",
  "keywords": [
    "@apsw/gridwright",
    "data-grid",
    "datagrid",
    "table",
    "vue",
    "vue3"
  ],
  "license": "MIT",
  "author": "yaotzin1 <yaotzin1@o2.pl>",
  "homepage": "https://github.com/yaotzin1/apsw-gridwright/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaotzin1/apsw-gridwright.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/yaotzin1/apsw-gridwright/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@apsw/gridwright": "^0.24.0",
    "vue": "^3.4.0 || ^3.5.0"
  },
  "peerDependenciesMeta": {
    "@apsw/gridwright": {
      "optional": true
    }
  }
}
